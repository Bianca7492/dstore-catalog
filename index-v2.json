          "music_and_audio"
        ],
        "name": {
          "en-US": "BitChord"
        },
        "authorName": "kushagrasinghx",
        "summary": {
          "en-US": "Aesthetic YouTube Music client with synced lyrics and offline playback"
        },
        "description": {
          "en-US": "BitChord is an aesthetic YouTube Music client for Android, built for people who care how their music app looks and feels.\n\nFeatures:\n- Stream from YouTube Music with a clean, modern interface\n- Synchronized lyrics with word-by-word highlighting\n- Offline downloads for tracks, albums and playlists\n- Background playback with full media notification controls\n- Queue management with reordering and play-next\n- Spotify and Discord integration\n- Apple Music inspired and Material You themes\n- No ads, no tracking, no account required to start\n\nBitChord is not affiliated with, endorsed by, or connected to YouTube or Google in any way."
        },
