    "com.nikhil.yt": {
      "metadata": {
        "added": 1792589085024,
        "lastUpdated": 1792646362406,
        "categories": [
          "music_and_audio"
        ],
        "name": {
          "en-US": "Velune"
        },
        "authorName": "Nikhil",
        "summary": {
          "en-US": "Premium ad-free YouTube Music client for Android"
        },
        "description": {
          "en-US": "Velune is a premium ad-free YouTube Music client for Android built with Kotlin and Jetpack Compose.\n\nFeatures:\n- Ad-free YouTube Music playback\n- Background playback with battery optimization\n- Personalized Quick Picks and Keep Listening sections\n- Offline caching and downloads for playback without internet\n- Synced word-by-word lyrics with translation support\n- Material You dynamic theming that adapts to album art colors\n- Search for songs, albums, artists, playlists and videos\n- YouTube Music account login and library sync\n- Import playlists from YouTube Music\n- Gapless playback and crossfade\n- Silence skipping\n- Audio normalization (EBU R128)\n- Tempo and pitch control\n- Sleep timer\n- Discord Rich Presence integration\n- Last.fm and ListenBrainz scrobbling\n- Light, Dark, AMOLED and Dynamic themes\n- Customizable home feed\n\nVelune is not affiliated with YouTube or Google."
        },
