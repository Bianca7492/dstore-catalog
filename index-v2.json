    "io.github.aedev.flow": {
      "metadata": {
        "added": 1792589085024,
        "lastUpdated": 1792645588588,
        "categories": [
          "video_players_and_editors"
        ],
        "name": {
          "en-US": "Flow"
        },
        "authorName": "aedev",
        "summary": {
          "en-US": "Privacy-first YouTube and Music client with local recommendations"
        },
        "description": {
          "en-US": "Flow (YouTube-X) is a privacy-first YouTube and YouTube Music client. It provides a personalized feed using a completely local, on-device algorithm, giving you a modern discovery experience without tracking or accounts.\n\nFeatures:\n- Play videos and songs from YouTube and YouTube Music\n- Local recommendation engine that learns your preferences on-device\n- 100% on-device privacy with zero analytics or tracking\n- No Google account required\n- Background audio and Picture-in-Picture video playback\n- Built-in SponsorBlock to automatically skip sponsored segments\n- Built-in DeArrow to replace clickbait titles and thumbnails\n- Built-in Return YouTube Dislike\n- Download videos and audio for offline playback\n- Dedicated music player with synchronized live lyrics\n- Import subscriptions, playlists and history from YouTube, NewPipe and LibreTube\n\nFlow keeps your recommendations and watch history entirely on your own device."
        },
